# 실제 값은 .env.local 에 넣는다. .env* 는 .gitignore 대상이다.
# SMTP 설정이 없어도 사이트는 정상 동작한다 — 문의는 data/contact.jsonl 에 적재된다.

# Gmail 사용 시: 계정 비밀번호가 아니라 '앱 비밀번호'를 발급받아 넣는다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=앱-비밀번호-16자리

# 문의를 받을 주소
CONTACT_TO=me@stockdruid.me

# 문의 적재 경로. 지정하지 않으면 standalone 산출물 안에 쌓여 배포 시 사라진다.
CONTACT_LOG_DIR=C:\Users\User\Documents\stockdruid-me\data

# ---- 관리자 로그인 ----
# 아래 두 값은 `npm run admin:hash` 로 생성한다.
# 비밀번호 원문은 어디에도 저장하지 않는다. scrypt 해시만 둔다.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
